# Copy this file to keystore.properties at the repo root and fill in your own
# values. keystore.properties and the keystore itself are gitignored and must
# NEVER be committed to the repository or pasted into chats.
#
# Generate your key OUTSIDE the repository, then point storeFile at it, e.g.:
#   keytool -genkeypair -v -keystore F:/keys/AnAnNotes-release.jks -alias anannotes -keyalg RSA -keysize 4096 -validity 10000
storeFile=F:/keys/AnAnNotes-release.jks
storePassword=CHANGE_ME
keyAlias=anannotes
keyPassword=CHANGE_ME
